catalog version=1 air=2
cap document syntax="air version=2" means="Selects the validated AIR language version." params=version constraints="Exactly one; version 2." tags="air document version"
cap application syntax="app <id> [title=] [subtitle=] [initial=]" means="Names the application and its initial semantic page." params="title,subtitle,initial" constraints="Exactly one stable app ID." tags="app application title navigation" requires=document
cap theme syntax="theme [mode=system|light|dark] [accent=violet|blue|emerald|rose|amber] [density=compact|comfortable]" means="Optional presentation preference; no layout implementation." params="mode,accent,density" constraints="At most one." tags="theme presentation display" requires=application
cap local_storage syntax="capability storage.local" means="Authorizes reusable local persistence." params=- constraints="Data remains outside AIR application intent." tags="storage persistence capability" requires=application
cap resource syntax="resource <id> [singular=] [plural=] [icon=] [label=<field>]" means="Declares a stable business entity identity." params="singular,plural,icon,label" constraints="Unique ID; must have fields." tags="resource entity schema add contacts customer manager" requires=application
cap field syntax="field <resource>.<id> <type> [required] [unique] [label=] [default=]" means="Declares a stable data field; label is mutable display metadata." params="type,label,required,unique,values,ref,default,min,placeholder,long,currency" constraints="Types: text,email,phone,enum,date,ref,number,money,bool; type-specific properties validated." tags="field property schema language enum status metadata label rename identity" requires=resource
cap relationship syntax="field <resource>.<id> ref=<target> [required]" means="Declares a many-to-one relationship; the referenced resource must exist." params="ref,required,label" constraints="Use a separate resource plus ref for one-to-many collections." tags="relationship relation reference ref belongs contacts multiple owner assignment" requires="resource,field"
cap actor syntax="actor <resource>" means="Marks a resource as an authenticated actor identity usable by self and ownership policies." params=- constraints="Target must be a resource." tags="actor user identity principal ownership own authentication" requires=resource
cap manage syntax="manage <resource> [create=] [edit=] [delete=] [lifecycle=] [page_size=]" means="Infers list, detail, forms, validation, CRUD, search, filters, sorting, pagination, responsive and accessible states." params="create,edit,delete,lifecycle,page_size" constraints="Target resource exists; booleans or role IDs for actions." tags="manage crud list detail form search filter sort pagination ui resource management experience" requires="resource,field"
cap lifecycle syntax="manage <resource> lifecycle=delete|archive" means="Chooses hard-delete or archival behavior for a managed resource." params=lifecycle constraints="Archive preserves the record and excludes it from active queries." tags="lifecycle archive delete preserve" requires=manage
cap access syntax="access <resource> <action>=<policy>" means="Constrains managed actions; policies OR terms with |." params="view,create,edit,delete,archive" constraints="Terms: true,false,role:<id>,self,owner:<ref-path>; every owner segment is a ref and the path ends at an actor." tags="access permission authorization role admin owner ownership scoped scope own view edit update archive" requires="manage,actor,relationship"
cap overview syntax="overview [title=]" means="Infers a dashboard from managed resources and declared insights." params=title constraints="At most one." tags="overview dashboard summary" requires=manage
cap rule syntax="rule <resource>.<id> field=<field> from=<value> to=<value> after=<duration> since=<date-field>" means="Declares a deterministic elapsed-time state transition." params="field,from,to,after,since" constraints="Duration uses positive d or h; since is a date." tags="rule automation transition expire expiry trial duration days 30 45" requires=field
cap aggregate syntax="insight <resource>.<id> op=count|sum|average [field=] [group=] [where=<condition>] [label=] [tone=]" means="Adds a filtered overview aggregate or category breakdown over one resource." params="op,field,group,where,label,tone" constraints="Sum/average require a numeric field; group is enum/ref/bool; overview required." tags="insight aggregate count sum average revenue total pending paid category breakdown metric condition" requires="overview,field,condition"
cap grouped_aggregate syntax="insight <owner>.<id> op=count|sum|average source=<resource> group=<ref-field> [field=] [where=<condition>] [window=month date=<date-field>] [label=]" means="Adds a read-only per-owner aggregate through a relationship, optionally for the current calendar month." params="op,source,group,field,where,window,date,label" constraints="Group is a source ref to owner; sum/average require numeric field; month window requires a date." tags="relationship grouped aggregate count active per each monthly budget spend manager" requires="relationship,field,condition"
cap highlight syntax="highlight <resource>.<id> when=<field>:<value> [tone=accent|positive|warning|danger|neutral]" means="Declares semantic emphasis while leaving CSS to the runtime." params="when,tone" constraints="Field must exist; first matching highlight applies." tags="highlight semantic presentation vip status emphasis css"
cap patch_add syntax="add <declaration>" means="Adds one absent semantic declaration at its canonical address." params=- constraints="Fails if address exists or result is invalid." tags="patch add insert field relationship resource" requires=patch_safety
cap patch_set syntax="set <declaration-address> <property>=<value> [was_<property>=<old>]" means="Mutates named properties without rewriting unrelated declarations." params="declaration properties,was_*" constraints="Target must exist; validated atomically." tags="patch set change modify rename duration permission" requires=patch_safety
cap patch_assert syntax="assert <declaration-address> <property>=<value>" means="Validates already-satisfied intent and produces no semantic change." params="declaration properties" constraints="Target and exact property values must exist." tags="patch assert no-op existing already validation"
cap patch_safety syntax="was_<property>=<expected|<absent>>" means="Optimistic semantic precondition for conflict detection." params=was_* constraints="Mismatch aborts the whole patch; <absent> requires no explicit property." tags="patch safety conflict atomic audit reversible precondition default absent"
cap parameter syntax="parameter <resource>.<id> value=<scalar> [label=]" means="Names an independently changeable business threshold or value for stable guards and tiny patches." params="value,label" constraints="Owner resource and parameter ID must exist uniquely." tags="parameter threshold constant limit configuration auto approve finance amount patch" requires=resource
cap condition syntax="<path><op><value> [& ...] [| ...]" means="Deterministic bounded boolean condition over fields, reference paths, computed values, literals, and @parameters." params="paths,@parameters,+,==,!=,<,<=,>,>=,&,|" constraints="No code or parentheses; paths and parameters validate statically; conjunction binds inside alternatives." tags="condition guard predicate routing branch amount category aggregate relationship deterministic" requires="field,parameter"
cap process syntax="process <resource> state=<enum-field> initial=<state> terminal=<states> [history] [touch=<date-field>]" means="Declares state ownership, initial/terminal states, transition evidence, and optional mutation timestamp." params="state,initial,terminal,history,touch" constraints="State is an enum; all states reachable; nonterminal states have exits." tags="process workflow state machine initial terminal history updated" requires="manage,field"
cap transition syntax="transition <resource>.<id> from=<states> to=<state> [action= by= | automatic] [when=]" means="Declares one requested or deterministic state edge; external side effects are not implied." params="from,to,action,by,automatic,when,event,comment,approvals,distinct,separate,within,since,unless_event" constraints="States/actors/paths validate; automatic routing must be unambiguous; requested edges need action authority." tags="transition workflow action route state submit approve reject revise withdraw automatic guarded" requires="process,condition,actor"
cap transition_evidence syntax="transition ... approvals=<n> [distinct] [separate=<actor-path>] [comment=required|optional] [event=]" means="Requires actor evidence, separation of duty, comments, and immutable internal transition history before an edge completes." params="approvals,distinct,separate,comment,event,within,since,unless_event" constraints="Positive cardinality; distinct needs at least two; separation paths end at actors; no external event delivery." tags="approval multi approval cardinality distinct actor separation duty self approval comment rejection reason audit history semantic event" requires=transition
cap invariant syntax="invariant <resource>.<id> when=<condition> [require=<fields>] [immutable=<fields|*>]" means="Enforces conditional required fields and state/value-dependent immutability below the UI." params="when,require,immutable" constraints="Fields must be stored fields; at least one effect required." tags="invariant validation conditional required receipt reason travel immutable locked finalized paid" requires="condition,field"
cap deadline syntax="deadline <resource>.<id> state=<state> after=<h|d|bd> [escalation=required]" means="Derives on-time, overdue, and escalation-required semantics while the process remains in a review state." params="state,after,escalation" constraints="State must exist; bd means UTC weekdays and excludes holiday calendars." tags="deadline temporal time overdue escalation business days review sla" requires=process
cap exp_auth_login syntax="experience auth.login [actor=] [identity=]" means="Declares standard user identity authentication presentation flow." params="actor,identity,title,subtitle" constraints="Actor resource must exist." tags="auth login experience authentication sign in credentials password" requires=actor
cap exp_auth_standard syntax="experience auth.standard [actor=] [identity=]" means="Declares composite standard authentication, identity verification, recovery, and account lifecycle experience." params="actor,identity,title,subtitle" constraints="Actor resource must exist." tags="auth standard login register verification password reset profile security sessions experience" requires=actor
cap exp_user_management syntax="experience user.management [authority=]" means="Declares administrator user management and role assignment experience." params="authority,title,subtitle" constraints="Requires administrator authority." tags="user management admin roles security status experience" requires=actor
cap exp_workflow_inbox syntax="experience workflow.inbox [title=]" means="Declares an actor-adaptive review inbox for pending workflow transitions across processes." params="title,icon" constraints="Application must contain process declarations." tags="workflow inbox review approval queue pending actions experience" requires=process
