air version=2
app user_management_test title="User Management App"
capability storage.local
resource users label=name
field users.name text required
field users.email email required unique
field users.role enum values=Admin,Member default=Member
actor users
manage users
access users view=true edit=role:admin
experience auth.standard actor=users identity=email
experience user.management authority=role:admin
overview title="Overview"
